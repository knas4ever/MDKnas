{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDKnas",
  "version": "2026.11.15",
  "identifier": "dk.mdknas.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:renderer",
