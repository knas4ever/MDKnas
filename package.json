{
  "name": "wysiwyg-md-editor",
  "productName": "Markdown Editor",
  "version": "0.1.0",
  "description": "Offline WYSIWYG Markdown editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && electron . --dev",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --platform=node --bundle --external:electron --outdir=dist-electron",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --linux"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.6.0",
    "@playwright/test": "^1.44.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "markdown-it": "^14.0.0",
    "mermaid": "^10.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.example.mdeditor",
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" },
    "files": ["dist/**", "dist-electron/**"]
  }
}
